# =============================================================================
# RAG Darovi — production environment template
# =============================================================================
# Copy values into a secret manager or server-side `.env`. Do not commit secrets.
#
# Docker Compose: use service hostnames (postgres, redis, minio, milvus, ollama)
# for URLs seen *inside* containers — see docker-compose.yml `environment` / `x-app-env`.
# Use `localhost` only when the process runs on the host, not inside a container.
#
# Google OAuth: register the Web client redirect URI exactly as GOOGLE_OAUTH_REDIRECT_URI
# (e.g. https://app.example.com/auth/google/callback). Prefer HTTPS behind a reverse proxy.
# =============================================================================

# -----------------------------------------------------------------------------
# Google Drive — service account JSON (path inside container or mounted file)
# Pipeline workers read this for sync when no OAuth token is stored yet.
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
DRIVE_FOLDER_ID=

# -----------------------------------------------------------------------------
# Google Sheets — optional; path to credentials JSON for write features
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_CREDENTIALS=/run/secrets/google-service-account.json

# -----------------------------------------------------------------------------
# Google Drive OAuth — end-user browser consent (FastAPI)
# Use production HTTPS redirect URL registered in Google Cloud Console.
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/auth/google/callback

# Fernet key (32-byte url-safe base64) — encrypts OAuth refresh tokens at rest (required in prod)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Long random string — signs Starlette session cookies (OAuth + /drive/* access)
APP_SESSION_SECRET=generate-a-long-random-string-here

# -----------------------------------------------------------------------------
# MinIO — object storage (strong credentials; TLS if exposed publicly)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me-minio-access
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-files
MINIO_BUCKET_TEXT=converted-texts

# -----------------------------------------------------------------------------
# PostgreSQL — strong passwords; host = Compose service name from app containers
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://raguser:CHANGE_ME_STRONG_PASSWORD@postgres:5432/rag_darovi
DATABASE_URL_SYNC=postgresql+psycopg2://raguser:CHANGE_ME_STRONG_PASSWORD@postgres:5432/rag_darovi
DATABASE_URL_GENERATED=postgresql+asyncpg://raguser:CHANGE_ME_STRONG_PASSWORD@postgres:5432/rag_darovi

# -----------------------------------------------------------------------------
# Redis — optional password: redis://:password@redis:6379/0 (repeat for /1 and /2)
# -----------------------------------------------------------------------------
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Milvus — vector store (internal hostname on Docker network)
# -----------------------------------------------------------------------------
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_documents

# -----------------------------------------------------------------------------
# Ollama — embedding + chat when LLM_PROVIDER=ollama (Compose service `ollama`)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
EMBED_BATCH_SIZE=64
OLLAMA_PULL_MODELS=nomic-embed-text,qwen3.5:9b

# -----------------------------------------------------------------------------
# LLM — set LLM_API_KEY / LLM_BASE_URL for cloud OpenAI-compatible APIs if not using Ollama
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
LLM_BASE_URL=http://ollama:11434/v1/

# -----------------------------------------------------------------------------
# Celery Beat — Drive incremental sync cadence (hours)
# -----------------------------------------------------------------------------
SYNC_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# FastAPI — listen on all interfaces; terminate TLS at reverse proxy or here
# API_KEY: require X-API-Key and WebSocket ?api_key= when set
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=generate-a-long-random-api-key

# TLS inside Uvicorn (optional). Often empty when Traefik/Caddy/nginx handles HTTPS.
# If set, paths are inside the container (e.g. ./certs mounted to /etc/rag/certs)
API_SSL_CERTFILE=
API_SSL_KEYFILE=
