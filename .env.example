# =============================================================================
# Local development environment (not committed — copy from .env.example)
# Loaded by Pydantic Settings: config/settings.py
# =============================================================================

# -----------------------------------------------------------------------------
# Ingestion source
# INGEST_SOURCE=drive -> pull from Google Drive
# INGEST_SOURCE=local -> pull from LOCAL_SOURCE_FOLDER on local filesystem
# -----------------------------------------------------------------------------
INGEST_SOURCE=local
# LOCAL_SOURCE_FOLDER is set in docker-compose.yml for each container that needs it

# -----------------------------------------------------------------------------
# Google Drive — service account (pipeline sync: Celery workers)
# JSON key with Drive read-only; share the target Drive folder with the SA email.
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
# Optional: restrict sync to one folder ID from the Drive URL (.../folders/FOLDER_ID)
DRIVE_FOLDER_ID=

# -----------------------------------------------------------------------------
# Google Sheets — optional writes (LLM generator); same or another SA JSON if needed
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_CREDENTIALS=credentials/service-account.json

# -----------------------------------------------------------------------------
# Google Drive OAuth — browser “Connect Google Drive” flow (FastAPI)
# If GOOGLE_OAUTH_CLIENT_ID is empty, only service-account mode is used.
# Redirect URI must match Google Cloud Console → OAuth Web client (exact string).
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=123847188546-qr9ml88ksk1647v138qlud0l4v1v752g.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=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
GOOGLE_OAUTH_REDIRECT_URI=https://192.168.86.208.sslip.io:8000/auth/google/callback

# Fernet key (url-safe base64) to encrypt OAuth refresh tokens in Postgres; empty = plaintext (dev only)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=KETKkfjOjeqsKcwK7sazUJjHvK7Ojw2_tIKa9Wpovec=
# Secret for Starlette signed cookies (OAuth state + session for /drive/* routes)
APP_SESSION_SECRET=change-me-in-production

# -----------------------------------------------------------------------------
# MinIO — object storage (raw files + converted text)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# true if using HTTPS to MinIO (e.g. public endpoint)
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-files
MINIO_BUCKET_TEXT=converted-texts

# -----------------------------------------------------------------------------
# PostgreSQL — metadata (async: FastAPI; sync URL: Celery)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_darovi
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_darovi
# Optional separate DB for LLM-generated SQL (restricted schema in production)
DATABASE_URL_GENERATED=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_darovi

# -----------------------------------------------------------------------------
# Redis — DB 0 broker, 1 results, 2 cache + conversation memory (isolated logical DBs)
# -----------------------------------------------------------------------------
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_URL=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Milvus — vector index (embeddings)
# -----------------------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_documents

# -----------------------------------------------------------------------------
# Docker Compose — activar profiles automáticamente desde .env
# local-embed: levanta el contenedor ollama para embeddings locales
# Dejar vacío cuando EMBED_USE_EXTERNAL_API=TRUE (ollama no arranca)
# -----------------------------------------------------------------------------
COMPOSE_PROFILES=local-embed

# -----------------------------------------------------------------------------
# Ollama — embeddings + optional local LLM (/api/embed, chat)
# Solo relevante cuando EMBED_USE_EXTERNAL_API=FALSE
# OLLAMA_PULL_MODELS: used by Docker ollama entrypoint to pre-pull images (comma-separated)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
EMBED_BATCH_SIZE=64
OLLAMA_PULL_MODELS=nomic-embed-text,qwen3.5:9b

# -----------------------------------------------------------------------------
# Embeddings — selector de backend
# EMBED_USE_EXTERNAL_API=TRUE  → llama API externa (OpenAI); ollama NO arranca
# EMBED_USE_EXTERNAL_API=FALSE → usa Ollama local (requiere COMPOSE_PROFILES=local-embed)
# Si cambias de proveedor actualiza también EMBED_DIM y recrea la colección Milvus.
# text-embedding-3-large produce 3072 dims; nomic-embed-text produce 768 dims.
# -----------------------------------------------------------------------------
EMBED_USE_EXTERNAL_API=FALSE
EMBED_EXTERNAL_API_URL=https://api.openai.com/v1
EMBED_EXTERNAL_API_KEY=
EMBED_EXTERNAL_MODEL=text-embedding-3-large

# -----------------------------------------------------------------------------
# LLM — OpenAI-compatible client (Ollama, OpenAI, etc.)
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1/
# DeepSeek explicit configuration (used when LLM_PROVIDER=deepseek).
# If DEEPSEEK_API_KEY is empty, the app falls back to LLM_API_KEY.
DEEPSEEK_API_KEY=sk-c278ac8b4a9c4ee2b6ab351df5bed3e2
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/

# -----------------------------------------------------------------------------
# Celery Beat — scheduled Drive incremental sync (hours)
# -----------------------------------------------------------------------------
SYNC_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# OCR tuning (legacy Tesseract — kept as fallback when vision is disabled or
# the vision circuit breaker is open). New deployments rely on VISION_* below.
# -----------------------------------------------------------------------------
# OCR language passed to Tesseract (examples: eng, spa, spa+eng)
OCR_LANGUAGE=eng
# Rasterization DPI used by pdf2image before OCR
OCR_DPI=300
# Optional Tesseract page segmentation mode (empty uses Tesseract default)
OCR_PSM=
# Minimum non-whitespace chars required to trust extracted text layer
OCR_MIN_TEXT_CHARS=40
# Minimum alphabetic ratio required to trust extracted text
OCR_MIN_ALPHA_RATIO=0.45
# Maximum ratio of single-character lines tolerated before classifying as low quality
OCR_MAX_SINGLE_CHAR_LINE_RATIO=0.6

# -----------------------------------------------------------------------------
# Vision-Language Model — Llama-3.2-Vision via dedicated Ollama container
# Replaces Tesseract for high-quality OCR and key-value extraction.
# Runs in a separate `ollama-vision` container (port 11436) to isolate VRAM
# from the embedding model. Pulls llama3.2-vision:11b on first start.
# -----------------------------------------------------------------------------
VISION_ENABLED=true
VISION_BASE_URL=http://localhost:11436
VISION_MODEL=llama3.2-vision:11b
# Per-request timeout (seconds). Default 180s covers complex pages on CPU.
VISION_REQUEST_TIMEOUT_S=180
# Soft cap (MB) above which images are downscaled to 2048 px / JPEG q=85.
VISION_MAX_IMAGE_MB=8
# Pages sent per VLM call. Keep at 1 to avoid OOM on large multi-page calls.
VISION_MAX_PAGES_PER_REQUEST=1
# Consecutive failures before the circuit breaker opens and falls back.
VISION_CIRCUIT_BREAKER_THRESHOLD=5
# Seconds before the breaker transitions back to half-open for probing.
VISION_CIRCUIT_BREAKER_RESET_S=300
# When true, fall back to Tesseract if the breaker is open or the VLM errors out.
VISION_FALLBACK_TO_TESSERACT=true
# Downscaled DPI used by retry path when the VLM times out on first attempt.
VISION_DOWNSCALE_DPI=200

# -----------------------------------------------------------------------------
# External Vision Provider (OpenAI-compatible API)
# Set VISION_EXTERNAL=true to use an external API instead of local Ollama.
# Works with OpenAI, Azure OpenAI, Google Gemini (OpenAI-compat), etc.
# When true, start Docker WITHOUT --profile local-vision to skip ollama-vision.
# When false (default), run: docker compose --profile local-vision up
# -----------------------------------------------------------------------------
VISION_EXTERNAL=false
VISION_EXTERNAL_BASE_URL=https://api.openai.com/v1
VISION_EXTERNAL_API_KEY=
VISION_EXTERNAL_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# FastAPI / Uvicorn
# API_KEY: if set, require header X-API-Key (and WebSocket ?api_key=); empty = no API auth
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# TLS inside Uvicorn (optional). Empty = HTTP only (common behind a reverse proxy).
# Docker app-api: generate certs with ./scripts/generate-local-certs.sh ./certs and mount ./certs:/etc/rag/certs
# Local without Docker: point to ./certs/cert.pem or leave empty
API_SSL_CERTFILE=/etc/rag/certs/cert.pem
API_SSL_KEYFILE=/etc/rag/certs/key.pem
