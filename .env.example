# =============================================================================
# Local development environment (not committed — copy from .env.example)
# Loaded by Pydantic Settings: config/settings.py
# =============================================================================

# LOCAL_SOURCE_FOLDER is set in docker-compose.yml for each container that needs it

# -----------------------------------------------------------------------------
# OpenAI — embeddings + vision (gpt-4o)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072
EMBED_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# MinIO — object storage (raw files + converted text)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# true if using HTTPS to MinIO (e.g. public endpoint)
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-files
MINIO_BUCKET_TEXT=converted-texts
# Browser-accessible MinIO URL (used to generate presigned links in chat sources)
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_ENDPOINT=http://localhost:9001

# -----------------------------------------------------------------------------
# PostgreSQL — metadata (async: FastAPI; sync URL: Celery)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_darovi
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_darovi
# Optional separate DB for LLM-generated SQL (restricted schema in production)
DATABASE_URL_GENERATED=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_darovi

# -----------------------------------------------------------------------------
# Redis — DB 0 broker, 1 results, 2 cache + conversation memory (isolated logical DBs)
# -----------------------------------------------------------------------------
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_URL=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Milvus — vector index (embeddings)
# For Zilliz Cloud: set MILVUS_URI + MILVUS_TOKEN; leave HOST/PORT for local.
# -----------------------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_documents
MILVUS_URI=
MILVUS_TOKEN=

# -----------------------------------------------------------------------------
# LLM — DeepSeek (OpenAI-compatible)
# DEEPSEEK_API_KEY takes priority; LLM_API_KEY is the fallback for generic clients.
# -----------------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/

# -----------------------------------------------------------------------------
# OCR tuning (legacy Tesseract — fallback when the vision circuit breaker is open)
# -----------------------------------------------------------------------------
# OCR language passed to Tesseract (examples: eng, spa, spa+eng)
OCR_LANGUAGE=eng
# Rasterization DPI used by pdf2image before OCR
OCR_DPI=300
# Optional Tesseract page segmentation mode (empty uses Tesseract default)
OCR_PSM=
# Minimum non-whitespace chars required to trust extracted text layer
OCR_MIN_TEXT_CHARS=40
# Minimum alphabetic ratio required to trust extracted text
OCR_MIN_ALPHA_RATIO=0.45
# Maximum ratio of single-character lines tolerated before classifying as low quality
OCR_MAX_SINGLE_CHAR_LINE_RATIO=0.6

# -----------------------------------------------------------------------------
# Vision-Language Model — OpenAI GPT-4o via OPENAI_API_KEY above
# Replaces Tesseract for high-quality OCR and key-value extraction.
# -----------------------------------------------------------------------------
VISION_ENABLED=true
VISION_MODEL=gpt-4o
# Per-request timeout (seconds).
VISION_REQUEST_TIMEOUT_S=180
# Soft cap (MB) above which images are downscaled to 2048 px / JPEG q=85.
VISION_MAX_IMAGE_MB=8
# Pages sent per VLM call. Keep at 1 to avoid large payloads.
VISION_MAX_PAGES_PER_REQUEST=1
# Consecutive failures before the circuit breaker opens and falls back.
VISION_CIRCUIT_BREAKER_THRESHOLD=5
# Seconds before the breaker transitions back to half-open for probing.
VISION_CIRCUIT_BREAKER_RESET_S=300
# When true, fall back to Tesseract if the breaker is open or the VLM errors out.
VISION_FALLBACK_TO_TESSERACT=true
# Downscaled DPI used by retry path when the VLM times out on first attempt.
VISION_DOWNSCALE_DPI=200

# -----------------------------------------------------------------------------
# FastAPI / Uvicorn
# API_KEY: if set, require header X-API-Key (and WebSocket ?api_key=); empty = no API auth
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# TLS inside Uvicorn (optional). Empty = HTTP only (common behind a reverse proxy).
# Docker app-api: generate certs with ./scripts/generate-local-certs.sh ./certs and mount ./certs:/etc/rag/certs
# Local without Docker: point to ./certs/cert.pem or leave empty
API_SSL_CERTFILE=/etc/rag/certs/cert.pem
API_SSL_KEYFILE=/etc/rag/certs/key.pem
