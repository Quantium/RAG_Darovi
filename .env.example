# =============================================================================
# RAG Darovi — environment template for local development
# Copy to `.env` and fill in values. See production.env.example for deployment hints.
# Settings: config/settings.py
# =============================================================================

# -----------------------------------------------------------------------------
# Ingestion source
# INGEST_SOURCE=drive -> pull from Google Drive
# INGEST_SOURCE=local -> pull from LOCAL_SOURCE_FOLDER on local filesystem
# -----------------------------------------------------------------------------
INGEST_SOURCE=drive
LOCAL_SOURCE_FOLDER=

# -----------------------------------------------------------------------------
# Google Drive — service account (Celery: download / sync from Drive)
# Create a JSON key in GCP; grant Drive API; share folders with the SA email.
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
# Optional folder ID from URL (.../folders/...); leave empty to list broadly (see downloader)
DRIVE_FOLDER_ID=

# -----------------------------------------------------------------------------
# Google Drive OAuth — optional UI onboarding (browser “Connect Google Drive”)
# Leave GOOGLE_OAUTH_CLIENT_ID empty to use only service account + DRIVE_FOLDER_ID above.
# OAuth Web client: redirect URI must match exactly (scheme, host, port, path).
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match a URI listed in Google Cloud Console (OAuth client) and the URL you use in the browser (same scheme/host/port).
# Do not edit the callback URL after Google redirects; start OAuth from the same host (session cookie + state).
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Fernet key to encrypt OAuth refresh tokens in the database; empty = plaintext (dev only)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Starlette session signing secret (OAuth state + /drive/* session cookies)
APP_SESSION_SECRET=change-me-in-production

# -----------------------------------------------------------------------------
# Google Sheets — optional writes (same SA JSON as Drive if Sheets scope granted)
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_CREDENTIALS=credentials/service-account.json

# -----------------------------------------------------------------------------
# MinIO — S3-compatible storage (raw uploads + normalized text)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-files
MINIO_BUCKET_TEXT=converted-texts

# -----------------------------------------------------------------------------
# PostgreSQL — application metadata (+ optional generated SQL schema)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_darovi
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_darovi
DATABASE_URL_GENERATED=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_darovi

# -----------------------------------------------------------------------------
# Redis — Celery broker (0), results (1), retriever cache + chat memory (2)
# -----------------------------------------------------------------------------
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_URL=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Milvus — vector database (chunk embeddings)
# -----------------------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_documents

# -----------------------------------------------------------------------------
# Ollama — embeddings API + local LLM
# OLLAMA_PULL_MODELS: comma-separated; used by Docker ollama service entrypoint on first start
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
EMBED_BATCH_SIZE=64
OLLAMA_PULL_MODELS=nomic-embed-text,qwen3.5:9b

# -----------------------------------------------------------------------------
# LLM — provider name + OpenAI-compatible base URL (e.g. Ollama /v1/)
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1/
# DeepSeek explicit configuration (used when LLM_PROVIDER=deepseek).
# If DEEPSEEK_API_KEY is empty, the app falls back to LLM_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/

# -----------------------------------------------------------------------------
# Celery Beat — interval for incremental Drive sync (hours)
# -----------------------------------------------------------------------------
SYNC_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# API — bind address/port; API_KEY enables X-API-Key / WebSocket api_key query
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# HTTPS (optional). Uvicorn TLS; leave commented for HTTP-only local dev.
# Generate self-signed: ./scripts/generate-local-certs.sh ./certs
# Docker compose mounts ./certs → /etc/rag/certs for app-api
# API_SSL_CERTFILE=/etc/rag/certs/cert.pem
# API_SSL_KEYFILE=/etc/rag/certs/key.pem
